rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function scoreProjectId(scoreId) {
      return firestore.get(
        /databases/(default)/documents/scores/$(scoreId)
      ).data.projectId;
    }

    function memberRole(projectId) {
      return firestore.get(
        /databases/(default)/documents/projects/$(projectId)
      ).data.members[request.auth.uid];
    }

    // Any project editor may write its score assets — not only whoever
    // uploaded the first revision.
    function canWriteScore(scoreId) {
      return memberRole(scoreProjectId(scoreId)) in ['owner', 'admin', 'editor'];
    }

    match /scores/{scoreId}/{allPaths=**} {
      allow read: if true;

      // The `!exists` branch is a hole: it lets any authenticated user write
      // arbitrary bytes under a score id that has not been created yet, with
      // no membership check at all. It cannot simply be removed — uploadScore
      // writes every file before creating scores/{scoreId}, so on a first
      // upload there is no document for canWriteScore to read. Removing it
      // requires creating the score document first. See TECH_DEBT.md.
      allow write: if request.auth != null && (
        !firestore.exists(/databases/(default)/documents/scores/$(scoreId)) ||
        canWriteScore(scoreId)
      );
    }

    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
