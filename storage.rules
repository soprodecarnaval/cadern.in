rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Storage permits only two Firestore document reads per request. The
    // project namespace avoids a third lookup through a score or songbook.
    function memberRole(projectId) {
      return firestore.get(
        /databases/(default)/documents/projects/$(projectId)
      ).data.get('deletedAt', null) == null
        ? firestore.get(
            /databases/(default)/documents/projects/$(projectId)/members/$(request.auth.uid)
          ).data.role
        : 'none';
    }

    match /projects/{projectId}/scores/{scoreId}/{revisionId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        memberRole(projectId) in ['owner', 'admin', 'editor'];
    }

    match /projects/{projectId}/songbooks/{songbookId}/{revisionId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        memberRole(projectId) in ['owner', 'admin'];
    }

    // Existing revisions keep their paths and download URLs. New client
    // uploads must use a project namespace, including new versions of these.
    match /scores/{scoreId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /songbooks/{songbookId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
